# PEARL Signature — Phase 2/3 environment (example file, safe to commit)
#
# Copy to `.env.local` for real values. `.env.local` is git-ignored and must
# never be committed or pasted into chat, docs, or support tickets.
#
# The application builds and runs WITHOUT any of these set:
# - Production without MONGODB_URI shows a customer-safe error state.
# - Local development without MONGODB_URI uses clearly labelled preview
#   fixtures (see docs/DATABASE_SCHEMA.md).

# ── MongoDB Atlas (Phase 2) ────────────────────────────────────────────
# Server-side only. Use a restricted user (readRole on the catalogue DB for
# the app; readWrite only for the seeding operator). Format:
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/pearl_signature?retryWrites=true&w=majority
MONGODB_URI=

# ── Cloudinary (Phase 2 delivery, Phase 3 signed uploads) ─────────────
# Cloud name only (safe to expose in URLs).
CLOUDINARY_CLOUD_NAME=
# API key + secret are REQUIRED for Phase 3 admin photo uploads (server
# signs upload requests; the secret never leaves the server). Use the
# Cloudinary dashboard → API Keys. Never commit real values.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Site metadata (optional) ───────────────────────────────────────────
# Production origin used for canonical URLs / Open Graph. Leave empty while
# the domain is undecided — metadata never invents a domain.
NEXT_PUBLIC_SITE_URL=

# ── Stripe payments (Phase 6, test mode only) ───────────────────────────
# All values are server-side except NEXT_PUBLIC_SITE_URL above. This phase
# rejects sk_live_* keys and never activates live payment processing.
# Payment requires BOTH this explicit server switch and the owner-managed
# online payment switch at /admin/settings. Environment presence alone does
# not enable it. Use Stripe test-mode keys only.
STRIPE_PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Transactional email (Phase 7, Resend free tier) ─────────────────────
# Everything here is optional. With none of it set, orders, payments and
# admin actions work exactly as before: every event is still recorded in
# notification_outbox, nothing is claimed as sent, and /admin/notifications
# shows the honest "not configured" readiness state. See
# docs/EMAIL_NOTIFICATIONS.md.
#
# NOTIFICATION_PROVIDER=resend enables real sending. Any other non-blank
# value is reported as unsupported instead of silently doing nothing.
NOTIFICATION_PROVIDER=
# Server-side only. Never expose this in the browser or commit a real key.
RESEND_API_KEY=
# A sender on a domain verified in Resend, either bare or with a display
# name: `orders@yourdomain.com` or `PEARL Signature <orders@yourdomain.com>`.
# A blank or malformed value is reported as invalid; no fallback address is
# ever invented.
EMAIL_FROM=
# Where owner/store alerts go. When blank, the active owner admin account is
# used; readiness still reports the environment value separately.
OWNER_NOTIFICATION_EMAIL=
# Optional Resend delivery webhook (bounced/complained/delivered). Not
# required for sending; without it, entries stay at "accepted".
RESEND_WEBHOOK_SECRET=
# Bearer secret for POST /api/notifications/process and the
# `npm run notifications:process` CLI. Leave blank and the HTTP endpoint
# answers 503 rather than running unauthenticated.
NOTIFICATION_PROCESSOR_SECRET=
# Free-tier ceilings used to stop before the provider quota is exhausted.
# Defaults: 3000/month, 100/day.
NOTIFICATION_MONTHLY_LIMIT=
NOTIFICATION_DAILY_LIMIT=

# ── Development/test switches (never set these in production) ──────────
# CATALOGUE_SOURCE=database|fixtures overrides source resolution for local
# work and automated tests. In production, "fixtures" must stay unset or the
# catalogue will serve preview content instead of real data.
CATALOGUE_SOURCE=
